# =============================================================================
# Cloudflare Tunnel Token
# CRIE EM: dash.cloudflare.com → Zero Trust → Networks → Tunnels
# COPIE ESTE ARQUIVO PARA .cloudflare.env E COLE O TOKEN
# =============================================================================

# Token do tunnel (formato: eyJhIjoi... ou UUID)
TUNNEL_TOKEN=eyJhIjoiCOLE_SEU_TOKEN_AQUI...