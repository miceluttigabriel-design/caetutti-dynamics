# =============================================================================
# Caetutti Dynamics - Variables de Entorno
# COPIA ESTE ARCHIVO A .env Y EDITA LOS VALORES
# NUNCA SUBAS .env A GITHUB (está en .gitignore)
# =============================================================================

# -----------------------------------------------------------------------------
# Dropi Credenciales (OBLIGATORIO - sin esto no sincroniza ni crea órdenes)
# -----------------------------------------------------------------------------
DROPI_EMAIL=tu@email.com
DROPI_PASSWORD=tu_password_dropi
DROPI_USER_ID=87773
DROPI_LOGIN_URL=https://app.dropi.com.py/

# -----------------------------------------------------------------------------
# Admin Panel (protege con credenciales fuertes)
# -----------------------------------------------------------------------------
ADMIN_EMAIL=admin@tudominio.com
ADMIN_PASSWORD=cambia_esta_clave_por_una_muy_segura_min_16_chars

# -----------------------------------------------------------------------------
# Tienda - Configuración general
# -----------------------------------------------------------------------------
STORE_NAME=Caetutti
PRICE_MARGIN_PERCENT=35
CURRENCY=PYG

# -----------------------------------------------------------------------------
# Sync Worker - Sincronización automática catálogo Dropi
# -----------------------------------------------------------------------------
SYNC_ENABLED=true
SYNC_INTERVAL_MIN=10
SYNC_MAX_PRODUCTS=4000

# -----------------------------------------------------------------------------
# Envío - Tarifa plana por defecto (se sobreescribe por dept/ciudad en admin)
# -----------------------------------------------------------------------------
SHIPPING_DEFAULT_PYG=60000

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
NODE_ENV=production
HEADLESS=true
PORT=4000
DATABASE_FILE=/data/caetutti.db

# -----------------------------------------------------------------------------
# Cloudflare Tunnel (OPCIONAL - para DNS + HTTPS gratis sin IP fija)
# Crea tunnel en https://dash.cloudflare.com -> Zero Trust -> Networks -> Tunnels
# -----------------------------------------------------------------------------
# TUNNEL_TOKEN=eyJhIjoi...tu_token_aqui...

# -----------------------------------------------------------------------------
# Notas importantes:
# -----------------------------------------------------------------------------
# 1. DROPI_EMAIL/PASSWORD: Credenciales de tu cuenta Dropi vendedor
# 2. DROPI_USER_ID: Sale del JWT de sesión (opcional, default 87773)
# 3. ADMIN_EMAIL/PASSWORD: Acceso a /admin - USA CLAVE FUERTE
# 4. PRICE_MARGIN_PERCENT: Margen sobre costo proveedor (35% = x1.35)
# 5. SYNC_INTERVAL_MIN: Cada cuántos minutos sincronizar catálogo (10 = recomendado)
# 6. SHIPPING_DEFAULT_PYG: Fallback si no hay tarifa dept/ciudad configurada
# 7. DATABASE_FILE: Ruta SQLite dentro del contenedor (volumen /data montado)
# 8. TUNNEL_TOKEN: Si usas Cloudflare Tunnel, pega el token aquí