# Dependencies
node_modules/
**/node_modules/

# Build outputs
.next/
out/
dist/
build/
*.tsbuildinfo

# Environment files (NUNCA commitear .env)
.env
.env.local
.env.production
.env.*.local

# Database
*.db
*.db-journal
*.sqlite
*.sqlite3
data/
**/data/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE/Editor
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Docker
.docker/
docker-compose.override.yml

# Test/coverage
coverage/
.nyc_output/

# OS
Thumbs.db
ehthumbs.db
Desktop.ini

# Certbot/SSL
certbot/
letsencrypt/

# Backups
backups/
*.backup
*.bak

# Temporary
tmp/
temp/
*.tmp
*.temp

# Playwright
playwright-report/
test-results/
.playwright/

# TypeScript cache
.tscache/

# Vercel/Netlify (no usar para este proyecto)
.vercel
.netlify

# PM2
.pm2/
ecosystem.config.js (si tiene secrets)

# Misceláneos
*.pem
*.key
*.crt
*.p12